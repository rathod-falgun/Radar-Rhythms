# =============================================================================
# Brahmaputra FloodWatch — Environment Variables
# NASA Space Apps Challenge 2026: Dancing with the SARs
# =============================================================================

# ISRO Bhoonidhi Satellite Data Portal Credentials
# Register at: https://bhoonidhi.nrsc.gov.in/
# NOTE: Never commit actual credentials or tokens to version control!
BHOONIDHI_USER_ID=your_bhoonidhi_username_here
BHOONIDHI_PASSWORD=your_bhoonidhi_password_here

# Bhoonidhi API Base URL (Default: https://bhoonidhi-api.nrsc.gov.in)
BHOONIDHI_BASE_URL=https://bhoonidhi-api.nrsc.gov.in
BHOONIDHI_TIMEOUT_SECONDS=20

# Server & CORS Configuration
# ---------------------------------------------------------------------------
# Backend port. 8000 is the local dev default; Vite proxy is configured to match.
PORT=8000

# Deployment environment: "development" (default) or "production"
ENVIRONMENT=development

# CORS Allowed Origins (comma-separated list of allowed frontend origins).
#
# Local development (Vite default port):
#   CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
#
# If you also run on the old CRA/Next.js port locally (dev only):
#   # CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
#
# Production — replace with your actual deployed frontend domain:
#   CORS_ALLOWED_ORIGINS=https://your-deployed-frontend-domain.com
#
# Leave as default below for local development:
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://radar-rhythms.vercel.app

# Frontend API Base URL — required for production builds.
# Set to your backend's public URL before running: npm run build
# Leave empty for local development (Vite proxy handles /api/* automatically).
VITE_API_BASE_URL=
